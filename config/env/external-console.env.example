# External console / Kubernetes interaction defaults.
# Copy to .env.external-console for local use. Do not commit real tokens.

# External console CLI command, API URL, and access token.
EXTERNAL_CONSOLE_CLI=
EXTERNAL_CONSOLE_URL=
EXTERNAL_CONSOLE_TOKEN=

# External cluster handles used by the CLI. Handles can be written with or without '@'.
# Example:
# EXTERNAL_CLUSTER_HANDLES="cluster-1 cluster-2"
EXTERNAL_CLUSTER_HANDLES=

# Local kube contexts to inspect. These can come from external get-credentials or
# an existing AWS/EKS kubeconfig.
CLUSTER_CONTEXTS="cluster-1 cluster-2"

# Optional role mapping for existing management/target scripts.
MGMT_CONTEXT=
TARGET_CONTEXT=

# Namespaces highlighted by scripts/cluster-interactions.sh.
INTERACTION_NAMESPACES="management target sandbox default kube-system"
EVENT_LIMIT=12
