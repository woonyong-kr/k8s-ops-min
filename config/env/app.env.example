DATABASE_URL=
NATS_URL=
REDIS_URL=
TARGET_CLUSTER_ID=
EVIDENCE_INTERVAL_SECONDS=8
PORT=8000

# 사용자 세션과 agent token은 환경 구분 없이 항상 검증합니다.
APP_ENV=production
RCA_TEST_RUNS_ENABLED=0
TEST_FIXTURE_PURGE_ENABLED=0
TRUSTED_PROXY_AUTH_USER_ID=
TRUSTED_PROXY_AUTH_WORKSPACE_ID=
# Resources pagination cursor HMAC key (minimum 32 bytes, deployment scripts generate it).
FILTER_CURSOR_SIGNING_KEY=

# Open-source/deploy friendly resource prefix.
PROJECT_SLUG=kubeheal

# Provider catalog. 콤마구분 "category:key" 값으로 운영자가 provider를 비활성화할 수 있습니다.
# 예: KUBEHEAL_DISABLED_PROVIDERS=cloud:aws,deploy:jenkins
KUBEHEAL_DISABLED_PROVIDERS=

# Secret refs. 기본 auto는 env:/unprefixed ref를 환경변수에서 읽고,
# k8s-secret:/aws-sm: ref는 각각 Kubernetes Secret/AWS Secrets Manager adapter로 라우팅합니다.
SECRET_VAULT_PROVIDER=auto
TOKEN_VAULT_PROVIDER=auto
SECRET_VAULT_AWS_REGION=
KUBEHEAL_K8S_API_BASE=
KUBEHEAL_K8S_TOKEN_PATH=/var/run/secrets/kubernetes.io/serviceaccount/token
KUBEHEAL_K8S_CA_CERT_PATH=/var/run/secrets/kubernetes.io/serviceaccount/ca.crt
KUBEHEAL_K8S_SECRET_TIMEOUT_SECONDS=5
GITHUB_TOKEN_REF=env:GITHUB_TOKEN

# GitOps manifest source policy. Dev can use local files; hosted/prod should use remote refs.
GIT_MANIFEST_SOURCE_MODE=auto
GIT_LOCAL_MANIFEST_ENABLED=0
GIT_CHECKOUT_CACHE_ENABLED=0
GIT_CHECKOUT_CACHE_REQUIRED=0
GIT_CACHE_MAX_REPOS=8
GIT_CACHE_MAX_BYTES=1073741824
GIT_REMOTE_MANIFEST_ENABLED=1
GIT_REMOTE_MANIFEST_REQUIRED=1
GITOPS_REQUIRE_APPROVED_SNAPSHOT=1

# Mail delivery. Production should use smtp with SMTP_HOST and credentials.
MAIL_DELIVERY_MODE=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=1
SMTP_TIMEOUT_SECONDS=10

# Control-plane maintenance loops.
COMMAND_JANITOR_INTERVAL_SECONDS=15

# LLM Gateway. 미설정이면 AI 요청 시 명확히 실패하며, provider는 배포 환경이 선택합니다.
LLM_PROVIDER=
LLM_MODEL=
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
LLM_MAX_TOKENS=1024

# provider별 실제 키는 Kubernetes Secret 또는 로컬 env로 주입합니다.
LLM_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
ANTHROPIC_MODEL=
ANTHROPIC_VERSION=2023-06-01
GEMINI_API_KEY=
GOOGLE_API_KEY=
GEMINI_BASE_URL=
GEMINI_MODEL=
