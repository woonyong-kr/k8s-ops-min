# External console instances.
# Copy to .env.external-console-instances for local use. Do not commit real tokens.

EXTERNAL_CONSOLE_CLI=
EXTERNAL_CONSOLE_INSTANCES="cluster01 cluster02"

EXTERNAL_CONSOLE_CLUSTER01_NAME="클러스터01"
EXTERNAL_CONSOLE_CLUSTER01_OWNER="cluster01-cloud-sa"
EXTERNAL_CONSOLE_CLUSTER01_PROVIDER="AWS"
EXTERNAL_CONSOLE_CLUSTER01_REGION="us-east-1"
EXTERNAL_CONSOLE_CLUSTER01_HOSTING="shared"
EXTERNAL_CONSOLE_CLUSTER01_SIZE="large"
EXTERNAL_CONSOLE_CLUSTER01_CONSOLE_URL=
EXTERNAL_CONSOLE_CLUSTER01_CONSOLE_TOKEN=
EXTERNAL_CONSOLE_CLUSTER01_CLUSTER_HANDLES=

EXTERNAL_CONSOLE_CLUSTER02_NAME="클러스터02"
EXTERNAL_CONSOLE_CLUSTER02_OWNER="cluster02-cloud-sa"
EXTERNAL_CONSOLE_CLUSTER02_PROVIDER="AWS"
EXTERNAL_CONSOLE_CLUSTER02_REGION="us-east-1"
EXTERNAL_CONSOLE_CLUSTER02_HOSTING="shared"
EXTERNAL_CONSOLE_CLUSTER02_SIZE="large"
EXTERNAL_CONSOLE_CLUSTER02_CONSOLE_URL=
EXTERNAL_CONSOLE_CLUSTER02_CONSOLE_TOKEN=
EXTERNAL_CONSOLE_CLUSTER02_CLUSTER_HANDLES=

# Set to true only when you want to update local kubeconfig from each Console.
FETCH_KUBECONFIG=false
